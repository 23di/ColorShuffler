{
  "name": "color-shuffler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:ui && npm run build:main",
    "build:main": "esbuild src/plugin/code.ts --bundle --outfile=dist/code.js --format=iife --platform=browser --target=es6",
    "build:ui": "node scripts/build-ui.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.117.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.10",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
